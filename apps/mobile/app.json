{
  "expo": {
    "name": "VAD",
    "slug": "vad-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/vad-logo-square.png",
    "scheme": "vad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/vad-logo-square.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A24",
        "foregroundImage": "./assets/images/vad-logo-square.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/vad-logo-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A24",
          "image": "./assets/images/vad-logo-square.png",
          "imageWidth": 156,
          "dark": {
            "backgroundColor": "#030414",
            "image": "./assets/images/vad-logo-square.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VAD to access a photo you choose for a market image.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
